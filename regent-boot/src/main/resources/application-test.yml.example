# 测试配置模板。复制为 application-test.yml 并填入真实凭据 —— 该文件已被 .gitignore 排除。
#
# 测试永远指向 regent_test，绝不允许指向开发库，见 AGENTS.md 数据库铁律第 6 条。
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/regent_test?characterEncoding=UTF-8&connectionTimeZone=UTC&useSSL=false&allowPublicKeyRetrieval=true
    username: regent
    password: 在此填入本地密码
  flyway:
    # 仅测试 profile 允许 clean，用于重建干净的测试库
    clean-disabled: false
regent:
  plan:
    scheduler:
      # 集成测试自己控制计划启动与收敛，避免后台定时器干扰事务回滚。
      enabled: false
  execution:
    # 集成测试自己会调派发用例；心跳开着会让测试期间冒出真实的执行进程
    dispatch:
      enabled: false
