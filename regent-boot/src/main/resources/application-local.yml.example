# 本地开发配置模板。
# 复制为 application-local.yml 并填入真实凭据 —— 该文件已被 .gitignore 排除，永不入库。
#
# 本机已就绪的环境（2026-10-16 由 Codex 创建）：
#   库：  regent / regent_test（utf8mb4 / utf8mb4_0900_ai_ci）
#   账号：regent，仅授权 regent.* 与 regent_test.*，看不到实例上其它项目的库
spring:
  datasource:
    username: regent
    password: 在此填入本地密码
  mail:
    # 邮箱注册验证码。只把真实账号密码写进 application-local.yml（已 gitignore）。
    host: smtp.126.com
    port: 465
    username: 在此填入发件邮箱
    password: 在此填入 SMTP 授权码
    properties:
      mail.smtp.auth: true
      mail.smtp.ssl.enable: true
  flyway:
    # 演示数据默认不加载（2026-10-16 起）：本地库保持干净，录入的都是真实数据。
    # 想灌回演示数据（45 条任务、10 张决策单，分页开箱有三页）：把下一行换成注释里的那行，
    # 重启后端即可。db/seed/R__demo_data.sql 是幂等的（先按 ID 段删、再重建），可以反复加载；
    # 加载后项目路径指向真实仓库，务必确认下面的派发心跳仍是 false。
    # locations: classpath:db/migration,classpath:db/seed
    locations: classpath:db/migration

regent:
  auth:
    # 本地 HTTP 开发保持 false；生产 HTTPS 环境通过环境变量设为 true。
    cookie-secure: false
    email-code:
      # 邮箱里的“打开 Regent”链接。公网部署时改成用户实际访问的地址。
      home-url: http://127.0.0.1:12580
  execution:
    # 本地默认关掉派发心跳：一旦灌了演示数据（项目路径就是真实仓库），
    # 心跳一开就会真的把演示任务跑起来（烧 token、切分支、改文件）。
    # 要看自动派发就改成 true。
    dispatch:
      enabled: false
