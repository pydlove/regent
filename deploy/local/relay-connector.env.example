# 复制到 ~/.regent/relay-connector.env，填入服务器公网地址与中继共享密钥。
# 该文件在用户目录中，不进入仓库。
# 服务器直连端口方式：填 http://<服务器IP>:18787（与服务器 Nginx 的 listen 端口一致）
# 若服务器配了域名与 HTTPS，则填 https://regent.example.com
REGENT_RELAY_SERVER_URL=http://1.2.3.4:18787
REGENT_RELAY_LOCAL_URL=http://127.0.0.1:8787
REGENT_RELAY_SHARED_SECRET=请替换为与服务器完全一致的至少32字节随机密钥
REGENT_RELAY_CONNECTIONS=4
